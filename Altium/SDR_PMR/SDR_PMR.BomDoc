|RECORD=CatalogItem|ITEMTYPE=Automatic-NonVault|UNIQUEID=SMD0603Cap.IntLib\0603B332K500CT|DESIGNITEMID=0603B332K500CT|ITEMSOURCE=SMD0603Cap.IntLib|STATUS=Unknown|DESCRIPTION=WALSIN - 0603B332K500CT - CAPACITOR, MLCC, X7R, 3300PF, 50V, 0603|USERCOMMENTS=3n3, 50V, X7R|NOTE=|LINENUMBER=|SELECTEDPARAMETERSHASH="3n3, 50V, X7R","WALSIN - 0603B332K500CT - CAPACITOR, MLCC, X7R, 3300PF, 50V, 0603"|COMPONENTPARAMETERS="Automotive Qualification Standard=-",Capacitance=3n3,"Capacitance Tolerance=± 10%","Ceramic Capacitor Case=0603 [1608 Metric]","Comment=3n3, 50V, X7R","Component Kind=Standard",ComponentLink1Description=http://www.farnell.com/datasheets/2340522.pdf,ComponentLink1URL=http://www.farnell.com/datasheets/2340522.pdf,"Description=WALSIN - 0603B332K500CT - CAPACITOR, MLCC, X7R, 3300PF, 50V, 0603","Dielectric Characteristic=X7",Footprint=SMD0603,"Ibis Model=","Library Name=SMD0603Cap.IntLib","Library Reference=0603B332K500CT",Manufacturer=WALSIN,"Manufacturer Part Number=0603B332K500CT","MSL=MSL 1 - Unlimited<!--FANDB--><div class=""features-and-benefits-container""><div class=""features-and-benefits-desc-container""><span class=""features-and-benefits-container-desc"">SMD Multilayer Ceramic Capacitor, 0603 [1608 Metric], 3300 pF, 50 V, ± 10%, X7R</span></div><div class=""features-and-benefits-description""><span class=""features-benefits-value"">The general purpose series capacitors from Walsin are X7R dielectric multilayer ceramic chip capacitors (MLCC) that provides high electrical precision, stability and reliability. These MLCC capacitors consist of a conducting material and electrodes. The high density and high efficiency ceramic condensers are used to manufacture chip type miniaturized MLCC capacitors.</span></div><div class=""features-and-benefits-list""><ul class=""features-and-benefits-list-list""><li class=""features-and-benefits-list-item"">Capacitance values ranges from 100pF to 47?F</li><li class=""features-and-benefits-list-item"">EIA 0201, 0402, 0603, 0805, 1206, 1210, 1812 case sizes available</li><li class=""features-and-benefits-list-item"">Available voltage ratings are 6.3V, 10V, 16V, 25V, 35V, 50V, 100V</li><li class=""features-and-benefits-list-item"">Operating temperature range from -55°C to 125°C</li><li class=""features-and-benefits-list-item"">Available in ±5%, ±10%, ±20","Operating Temperature Max=125","Operating Temperature Min=-55","Packaging=Cut Tape",PCB3D=,"Pin Info=","Pricing 1=10=0,0068, 100=0,0053, 500=0,0038, 1000=0,0031, 2000=0,0027 (GBP)","Product Range=-",RoHS=YES,"Signal Integrity=",Simulation=,"Stock 1=10797","Supplier 1=Farnell","Supplier 2=Digi-Key","Supplier Part Number 1=2496853","Supplier Part Number 2=BC1249TR-ND","Voltage Rating=50"|CUSTOMPARAMETERS=
