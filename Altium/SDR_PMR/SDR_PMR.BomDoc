|RECORD=CatalogItem|ITEMTYPE=Automatic-NonVault|UNIQUEID=SMD0603Res.IntLib\WR06X82R0FTL|DESIGNITEMID=WR06X82R0FTL|ITEMSOURCE=SMD0603Res.IntLib|STATUS=Unknown|DESCRIPTION=WALSIN - WR06X82R0FTL - RESISTOR, THICK FILM, 82R, 1%, 75V, 0603|USERCOMMENTS=82R, 1%|NOTE=|LINENUMBER=|SELECTEDPARAMETERSHASH="82R, 1%","WALSIN - WR06X82R0FTL - RESISTOR, THICK FILM, 82R, 1%, 75V, 0603"|COMPONENTPARAMETERS="Automotive Qualification Standard=-","Comment=82R, 1%","Component Kind=Standard",ComponentLink1Description=http://www.farnell.com/datasheets/1960319.pdf,ComponentLink1URL=http://www.farnell.com/datasheets/1960319.pdf,"Description=WALSIN - WR06X82R0FTL - RESISTOR, THICK FILM, 82R, 1%, 75V, 0603","Footprint=SMD0603 - R","Ibis Model=","Library Name=SMD0603Res.IntLib","Library Reference=WR06X82R0FTL",Manufacturer=WALSIN,"Manufacturer Part Number=WR06X82R0FTL","MSL=MSL 2 - 1 year<!--FANDB--><div class=""features-and-benefits-container""><div class=""features-and-benefits-desc-container""><span class=""features-and-benefits-container-desc"">SMD Chip Resistor, 82 ohm, 75 V, 0603 [1608 Metric], 100 mW, ± 1%, WR06 Series</span></div><div class=""features-and-benefits-description""><span class=""features-benefits-value"">The WR06 series resistors from Walsin are general purpose thick film chip resistors. These resistors are constructed in a high grade ceramic body (aluminium oxide).</span></div><div class=""features-and-benefits-list""><ul class=""features-and-benefits-list-list""><li class=""features-and-benefits-list-item"">Resistance range includes E24 and E96 decade values from 1ohm to 10Mohm</li><li class=""features-and-benefits-list-item"">EIA 0603 case size</li><li class=""features-and-benefits-list-item"">Available in ?±100ppm/°C and -200ppm/°C to +400ppm/°C TCR values</li><li class=""features-and-benefits-list-item"">Available in ±1% and ±5% tolerance</li><li class=""features-and-benefits-list-item"">High reliability and stability</li><li class=""features-and-benefits-list-item"">Higher component and equipment reliability</li><li class=""features-and-benefits-list-item"">Lower assembly costs</li><li class=""features-and-benefits-list-item"">Reduced size of final equipment</li><li class=""features-and-benefits-list-item"">Continuous working voltage is 75V and rated power is 100","Packaging=Cut Tape",PCB3D=,"Pin Info=","Power Rating=100","Pricing 1=10=0.0128, 100=0.0043, 500=0.0026, 1000=0.0018, 2500=0.0014 (GBP)","Product Range=WR06 Series",Resistance=82R,"Resistance Tolerance=± 1%","Resistor Case Style=0603 [1608 Metric]","Resistor Element Material=Thick Film",RoHS=YES,"Signal Integrity=",Simulation=,"Stock 1=1700","Supplier 1=Farnell","Supplier Part Number 1=2502484","Temperature Coefficient=± 100","Voltage Rating=75"|CUSTOMPARAMETERS=
